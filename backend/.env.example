# CarbonTrail backend environment
# Copy to .env and adjust as needed. All values below are the defaults.

# Path to the DuckDB database file (read-only at runtime).
# Generated by `python backend/etl/ingest.py` from CSVs under /data/opendata/canada.
# In Docker this points at the mounted volume; bare-metal it defaults to
# backend/data/carbontrail.duckdb relative to the app.
CARBONTRAIL_DB=/app/data/carbontrail.duckdb

# --- AI layer (local Ollama-Cloud, OpenAI-compatible endpoint) ---
# Base URL of the Ollama OpenAI-compatible proxy.
#   Bare-metal (same host):     http://localhost:11434/v1
#   Docker (proxy on the host): http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Model id served by the Ollama proxy.
LLM_MODEL=gpt-oss:120b-cloud

# Set to 1 to force the deterministic rule-based fallback (skip the LLM entirely).
AI_DISABLED=0
